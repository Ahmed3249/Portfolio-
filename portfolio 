<style>
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{font-family:Arial,Helvetica,sans-serif;background:#f7f9fc;color:#172033;line-height:1.6}
nav{position:fixed;top:0;width:100%;background:rgba(255,255,255,.92);backdrop-filter:blur(10px);z-index:10;border-bottom:1px solid #e7ebf2}
.nav{max-width:1100px;margin:auto;padding:18px 24px;display:flex;justify-content:space-between;align-items:center}
.logo{font-weight:800;font-size:22px;color:#1769e0}
nav a{color:#3d4655;text-decoration:none;margin-left:24px;font-size:14px}
nav a:hover{color:#1769e0}
section{max-width:1100px;margin:auto;padding:95px 24px}
.hero{min-height:100vh;display:flex;align-items:center;gap:60px;padding-top:130px}
.hero-text{flex:1}
.tag{display:inline-block;background:#eaf2ff;color:#1769e0;padding:8px 14px;border-radius:20px;font-size:13px;font-weight:700;margin-bottom:20px}
h1{font-size:clamp(46px,7vw,76px);line-height:1.05;margin-bottom:18px}
h1 span{color:#1769e0}
.hero p{font-size:18px;color:#626d7d;max-width:620px;margin-bottom:30px}
.buttons{display:flex;gap:14px;flex-wrap:wrap}
.btn{padding:13px 20px;border-radius:10px;text-decoration:none;font-weight:700;font-size:14px}
.primary{background:#1769e0;color:white}
.secondary{border:1px solid #d6dce7;color:#263244;background:white}
.hero-card{width:300px;height:330px;background:white;border:1px solid #e5eaf2;border-radius:28px;display:flex;align-items:center;justify-content:center;box-shadow:0 20px 50px rgba(25,55,100,.09)}
.avatar{width:150px;height:150px;border-radius:50%;background:#eaf2ff;color:#1769e0;display:flex;align-items:center;justify-content:center;font-size:54px;font-weight:800}
.section-title{font-size:38px;margin-bottom:12px}
.section-sub{color:#697586;margin-bottom:35px}
.about{display:grid;grid-template-columns:1.2fr .8fr;gap:30px}
.card{background:white;border:1px solid #e5eaf2;border-radius:18px;padding:28px;box-shadow:0 10px 30px rgba(25,55,100,.04)}
.card h3{margin-bottom:10px}
.card p{color:#687385}
.skills{display:flex;flex-wrap:wrap;gap:12px;margin-top:20px}
.skill{padding:10px 15px;background:#eef4ff;color:#1769e0;border-radius:9px;font-weight:700;font-size:14px}
.learning{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}
.learn-icon{font-size:28px;margin-bottom:12px}
.contact{background:#172033;color:white;border-radius:24px;padding:45px}
.contact p{color:#c7ced9;margin:10px 0 25px}
.contact a{color:white}
footer{text-align:center;padding:30px;color:#7b8492;font-size:13px}
@media(max-width:750px){
nav .links{display:none}
.hero{flex-direction:column;text-align:center;justify-content:center}
.hero p{margin-left:auto;margin-right:auto}
.buttons{justify-content:center}
.hero-card{width:240px;height:240px}
.about,.learning{grid-template-columns:1fr}
}
</style>
</head>
